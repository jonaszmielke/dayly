{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "react", "nextjs", "jsx-a11y", "import", "unicorn", "oxc"],
    // ESLint-compatible plugins run through oxlint's JS plugin support
    "jsPlugins": ["eslint-plugin-better-tailwindcss"],
    "settings": {
        "better-tailwindcss": {
            "entryPoint": "src/app/globals.css",
            // lets px arbitrary values map to the spacing scale (e.g. px-[10px] → px-2.5)
            "rootFontSize": 16
        }
    },
    "categories": {
        "correctness": "error"
    },
    "env": {
        "browser": true,
        "node": true,
        "es2024": true
    },
    "ignorePatterns": [
        ".next/**",
        "out/**",
        "build/**",
        "design/**",
        "next-env.d.ts",
        "src/generated/**"
    ],
    "rules": {
        // React hooks + React Compiler (was eslint-plugin-react-hooks via eslint-config-next)
        "react/rules-of-hooks": "error",

        // TypeScript (was typescript-eslint recommended)
        "typescript/ban-ts-comment": "error",
        "typescript/no-explicit-any": "error",
        "typescript/no-empty-object-type": "error",
        "typescript/no-namespace": "error",
        "typescript/no-require-imports": "error",
        "typescript/no-unnecessary-type-constraint": "error",
        "typescript/no-unsafe-function-type": "error",
        "typescript/no-wrapper-object-types": "error",
        "typescript/prefer-as-const": "error",
        "typescript/triple-slash-reference": "error",
        "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],

        // Tailwind: same check as the editor's suggestCanonicalClasses
        "better-tailwindcss/enforce-canonical-classes": "warn",

        // Project overrides
        "eslint/curly": "off",
        "eslint/no-console": ["warn", { "allow": ["warn", "error"] }]
    }
}
